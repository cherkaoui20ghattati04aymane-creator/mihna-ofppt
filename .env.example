# Copier vers .env. Ne jamais versionner ce fichier une fois rempli.
# Le premier lancement demande de créer un mot de passe personnel dans le navigateur.
COOKIE_SECURE=false
DATABASE=database/stages_marrakech.db
PRIVATE_DIR=private
BACKUP_DIR=backups
TRUSTED_HOSTS=127.0.0.1,localhost,[::1]
TRUST_PROXY=false
PUBLIC_DEMO_MODE=false
PUBLIC_DEMO_DATA_CONFIRMED=false

# AUCUN service externe n'est activé par défaut.
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Gemini (service centralisé backend/services/gemini_service.py) ---
# Pour activer : GEMINI_ENABLED=true, GEMINI_API_KEY=<votre clé AI Studio>, GEMINI_FREE_TIER_CONFIRMED=true,
# puis redémarrer et lancer TESTER_GEMINI.bat (vraie requête). La clé reste UNIQUEMENT dans .env (ignoré par Git).
# Niveau gratuit : Google indique que les données envoyées peuvent servir à améliorer ses produits ;
# l'application n'envoie jamais nom, email, téléphone, liens ni photo, et demande votre accord avant chaque envoi.
GEMINI_ENABLED=false
GEMINI_API_KEY=
# Modèle stable vérifié dans la documentation officielle (ai.google.dev) en novembre 2026.
GEMINI_MODEL=gemini-3.1-flash-lite
# Liste blanche (séparateur virgule). Vide = gemini-3.1-flash-lite, gemini-3.1-flash-lite, gemini-3.6-flash, gemini-3.8-flash
GEMINI_ALLOWED_MODELS=
# À mettre à true uniquement après vérification des quotas/conditions du projet Google Cloud.
GEMINI_FREE_TIER_CONFIRMED=false
# Garde-fous : délai (secondes), requêtes par minute, plafond quotidien local, cache des réponses identiques (secondes).
GEMINI_TIMEOUT_SECONDS=20
GEMINI_RATE_PER_MINUTE=8
GEMINI_DAILY_LIMIT=200
GEMINI_CACHE_TTL_SECONDS=900

# Recherche Internet Gemini Search désactivée par défaut.
# L'API Google Search Grounding n'est pas disponible dans le free tier API selon les tarifs officiels.
# Le niveau Standard avec facturation active inclut actuellement 5 000 requêtes de recherche/mois,
# puis 14 USD/1 000 recherches; une invite peut en déclencher plusieurs.
# Ne mettre les deux drapeaux à true qu'après votre propre vérification et autorisation de facturation.
GEMINI_SEARCH_ENABLED=false
GEMINI_SEARCH_MODEL=gemini-3.8-flash
GEMINI_SEARCH_BILLING_CONFIRMED=false
GEMINI_SEARCH_MAX_SESSION=2
GEMINI_SEARCH_MAX_DAILY=5
GEMINI_SEARCH_COOLDOWN_SECONDS=60
GEMINI_SEARCH_TIMEOUT_MS=30000

# Clé navigateur publique, distincte de la clé serveur Places, restreinte HTTP referrer/API.
MAPS_ENABLED=false
MAPS_BROWSER_KEY=

# Collectes uniquement par commande explicite --allow-external ; pas au démarrage web.
GOOGLE_PLACES_API_KEY=
